# fogar-gateway — configuración de ejemplo.
#
# Docker: copia a `.env`, junto a docker-compose.yml, y ajusta:   cp .env.sample .env
# Instalación nativa: `fogar-gw init` crea `<base>/config.env`; copia ahí lo que necesites.
# Desde Docker: `fogar-gw migrate --from-docker <carpeta>` convierte este `.env` en `<base>/config.env`.
# Cada línea corresponde a un campo de `src/fogar_gateway/core/config.py::Settings`; los valores
# activos son los defaults (tests/unit/test_env_sample.py lo comprueba).
#
# Las direcciones de servicios son `host:port` SIN protocolo: cada cliente añade
# `http://` o `ws://` por su cuenta. No pongas URLs completas.
#
# OBLIGATORIAS para operar de verdad:  ADMIN_TOKEN, OPENCLAW_TOKEN.
# El resto es opcional: déjalo como está salvo que tu despliegue lo requiera.

# ── Base de datos ────────────────────────────────────────────────────────────
# Fichero SQLite local. Una ruta relativa cuelga del directorio base (FOGAR_GATEWAY_HOME o
# ~/.fogar-gateway), nunca del directorio actual. El directorio padre se crea solo si no existe.
DATABASE_URL=sqlite:///data/gateway.db

# Un solo proceso por base de datos: el gateway toma un flock sobre `gateway.lock` junto a
# la BD y se niega a arrancar si otro proceso ya lo tiene (multi-worker no está soportado:
# sesiones y registro de bridges son por proceso). `false` desactiva el guard.
# Con `uvicorn --reload` funciona (el proceso viejo suelta el lock antes de lanzar el nuevo).
SINGLE_PROCESS_LOCK=true

# ── Revocación de sesiones vivas ─────────────────────────────────────────────
# Cada sesión WS se revalida contra la BD cada N s; si el cliente fue borrado, desactivado o
# su clave rotada, se cierra con 4200 «credential revoked». Sin caché: un cambio por /admin/* o por la
# CLI corta la sesión en la siguiente revalidación (≤ intervalo).
SESSION_REVALIDATE_INTERVAL_S=10.0

# ── Token de la máquina (la CLI y la recuperación) ──────────────────────────
# OBLIGATORIA. Se envía en la cabecera `X-Admin-Token`. Se deja vacía a propósito:
# vacía => la API responde 503 a X-Admin-Token (fail-closed) en vez de aceptar uno por defecto.
# Al menos 32 caracteres: uno más corto arranca con un WARNING y `fogar-gw doctor` lo marca.
# Genera uno con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── IP real detrás de un proxy ───────────────────────────────────────────────
# Desde la 5.0 ninguna IP exime de credencial: `/v1/*` exige siempre
# `Authorization: Bearer <token>` de un aparato con `conversations:write`. TRUST_LOOPBACK y
# TRUSTED_NETWORKS ya no existen: si siguen en config.env, el gateway no arranca
# (`fogar-gw config unset TRUSTED_NETWORKS`).
# CSV de IPs/CIDRs autorizados a fijar `X-Real-IP` (tu reverse proxy): su `X-Real-IP` es la IP
# que sale en los logs. Cualquier otro peer que lo envíe es ignorado. Solo IPs/CIDRs separadas
# por comas; una entrada inválida (no IP/CIDR, `%`, `/0`) hace que ningún peer cuente como proxy.
TRUSTED_PROXIES=127.0.0.1,::1
# Host de escucha de `fogar-gw serve` (puerto 8004); default 0.0.0.0. Detrás de un proxy en el
# mismo host, 127.0.0.1 (solo loopback).
# GATEWAY_HOST=127.0.0.1
# Nombre con el que el gateway se presenta a los clientes al emparejarse (POST /pair; no sale en
# /.well-known/fogar-gateway). Vacío = nombre del equipo. En Docker, fíjalo: ahí el nombre del
# equipo suele ser el id del contenedor.
# GATEWAY_NAME=
# URLs https propias por las que se llega al gateway (CSV, sin ruta ni usuario), p. ej. un
# dominio con proxy inverso. Vacío = ninguna.
# PUBLIC_URLS=https://fogar.example.com

# ── Orquestador: OpenClaw ────────────────────────────────────────────────────
OPENCLAW_HOST=127.0.0.1
OPENCLAW_PORT=18789
# true = wss:// (TLS). Para un OpenClaw de otra máquina publicado con TLS, p. ej. su propio
# `tailscale serve` (gateway.tailscale.mode: serve): OPENCLAW_HOST=<máquina>.<tailnet>.ts.net,
# OPENCLAW_PORT=443, OPENCLAW_TLS=true.
OPENCLAW_TLS=false
# OBLIGATORIA. Token del gateway de OpenClaw (`gateway.auth.token` en openclaw.json).
OPENCLAW_TOKEN=changeme
# Agente por defecto de la instalación (#245): lo usa quien no pide agente y no tiene
# `default_agent` propio, y es el agente de una conversación nueva sin agente. Vacío = el
# agente por defecto de OpenClaw. Si no existe en OpenClaw, el gateway avisa al conectar.
# Se usa en minúsculas, como en OpenClaw (Main = main).
DEFAULT_AGENT=

# ── Conversaciones ───────────────────────────────────────────────────────────
# Hora local (0–23) a la que empieza el día: quien no elige conversación cae en la del día
# (una por cliente, agente y día) y pasa a la del día nuevo en su primer turno tras el corte.
CONVERSATION_DAY_START_HOUR=5
# Reconexión con backoff exponencial (segundos), en un solo bucle sin fin: tras una caída
# reintenta sin parar (el backoff se duplica desde INITIAL hasta MAX_BACKOFF y ahí se queda)
# hasta que OpenClaw vuelva; mientras tanto /ready responde 503 y los clientes ven
# `reconnecting`. La reconexión manual desde el admin corta la espera y reintenta al instante.
ORCHESTRATOR_RECONNECT_INITIAL_BACKOFF=1.0
ORCHESTRATOR_RECONNECT_MAX_BACKOFF=60.0

# ── Transcriptor (STT) ───────────────────────────────────────────────────────
# host:port sin protocolo.
TRANSCRIBER_WS_URL=localhost:9000
# Token de servicio = AUTH_TOKEN de fogar-transcriber. Vacío = transcriber sin auth.
# El gateway ya no le reenvía la client_key del cliente (#218).
TRANSCRIBER_TOKEN=
TRANSCRIBER_RECONNECT_INITIAL_BACKOFF=1.0
TRANSCRIBER_RECONNECT_MAX_BACKOFF=60.0
TRANSCRIBER_RECONNECT_MAX_DURATION=300.0

# ── TTS ──────────────────────────────────────────────────────────────────────
# host:port sin protocolo.
TTS_WS_URL=localhost:8005
# Vacío = el servicio TTS no exige clave. Si la exige, el mismo token que el servicio.
TTS_TOKEN=
# Proveedores de voz: fogar (servicios propios), elevenlabs u off (como con el servicio caído:
# STT off, sin transcripción y solo entra texto; TTS off, respuestas solo en texto). Se eligen
# al arrancar; cambiarlos exige reiniciar el gateway.
STT_PROVIDER=fogar
TTS_PROVIDER=fogar
# Segundos máximos para completar la autenticación con el servicio TTS.
TTS_AUTH_TIMEOUT_S=10.0
# Segundos máximos que el Transcriber tiene para responder `ready` tras el handshake.
TRANSCRIBER_READY_TIMEOUT_S=10.0
# TTS no mantiene socket entre turnos: backoff perezoso, sin estado DEGRADED.
TTS_RECONNECT_INITIAL_BACKOFF=1.0
TTS_RECONNECT_MAX_BACKOFF=60.0

# ── Plazos acotados (segundos) ───────────────────────────────────────────────
# Máximo para recibir el handshake tras conectar el WebSocket (antes 10 s; bajado a 5 s
# en #216: un cliente muy lento, p. ej. un Android con mala cobertura, puede necesitar subirlo).
HANDSHAKE_TIMEOUT_S=5.0
# Tamaño máximo (CARACTERES, no bytes) del primer mensaje del WebSocket; se comprueba antes de
# parsearlo/autenticarlo y se cierra con 4002 "handshake too large". Aparte, `fogar-gw serve`
# arranca uvicorn con un tope de 1 MiB para cualquier mensaje entrante; con `uvicorn` a mano
# rige el de uvicorn (16 MiB).
HANDSHAKE_MAX_BYTES=4096
# Hueco máximo SIN eventos durante un turno (se reinicia con cada evento).
TURN_TIMEOUT_S=120.0
# Cierra la sesión si el cliente no envía nada en este tiempo (sin aviso previo).
IDLE_TIMEOUT_S=300.0
# Tope de cada paso del cierre de una sesión (cancelar el turno en curso y el push,
# cerrar el transcriber y el registro) y del envío de los últimos mensajes al cliente.
SESSION_TEARDOWN_S=5.0
# Tope de cada espera del TTS: turnos de push (#130 S3a, #199) y normales (#214). Por
# operación; la espera del audio (turno normal y push) es por tiempo SIN progreso del
# TTS (se reinicia con cada chunk).
PUSH_TTS_DRAIN_TIMEOUT_S=30.0
# Pacing del audio TTS (7e): el gateway envía a ritmo de reproducción, como mucho AUDIO_LEAD_S por delante
AUDIO_PACING_ENABLED=true
AUDIO_LEAD_S=2.0
# Un envío al cliente bloqueado más de este tiempo lo marca como lento y cierra la
# conexión (issue #130 S2). Es por envío, no acumulado.
CLIENT_SEND_TIMEOUT_S=10.0
# Eventos de OpenClaw que una conversación retiene mientras espera el ack de un `send`
# o a que se cierre el turno abierto (issue #130 S3b, 5.0). El run que no cabe falla con
# TURN_ERROR "internal_error" y se aborta (solo él); el fin de un push nunca se descarta.
TURN_QUEUE_MAX=1000

# ── Proveedores de voz (src/fogar_gateway/services/speech/) ───────────────────
# TTS y STT "elevenlabs" implementados (fases 3 y 4). STT_PROVIDER/TTS_PROVIDER: ver arriba.
# ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=wss://api.elevenlabs.io
# El resto de ajustes de ElevenLabs son constantes en src/fogar_gateway/services/speech/elevenlabs/ (#264).
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Voz por defecto (español, no es un secreto); solo falla el arranque si se deja en blanco.
# ELEVENLABS_TTS_DEFAULT_VOICE=gc61tTk93h3LBXPxew2V
# Mapa JSON voz del cliente -> voz del proveedor, p. ej. {"af_heart":"<voice_id>"}
# TTS_VOICE_MAP={}
# Puerta de energía del STT de ElevenLabs (solo envía audio mientras se habla): energy u off.
# fogar no la usa. `auto` (el valor anterior) se sigue aceptando como alias de `energy`.
# STT_AUDIO_GATE=energy
# STT_GATE_RMS_DBFS=-45.0
# Formato de los logs: text (por defecto) o json (una línea JSON por registro; la imagen Docker usa json).
# LOG_FORMAT=text
